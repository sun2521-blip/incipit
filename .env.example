
# Frontend: URL of the Incipit API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# GitHub token (backend only, never NEXT_PUBLIC_). Optional locally, but
# practically required when deployed: each page of results also looks up
# every repository on it (up to 20 calls), and without a token GitHub allows
# only 60 such calls an hour. A fine-grained token with no extra
# permissions (public repositories, read-only) is enough.
GITHUB_TOKEN=

# Backend: comma-separated allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000
